# API Keys (Required)
ANTHROPIC_API_KEY=sk-ant-api03-placeholder
TAVILY_API_KEY=tvly-placeholder

# Application Security
API_AUTH_TOKEN=dev-secret-token-change-in-prod
RATE_LIMIT_PER_MINUTE=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_RUN_TTL_SECONDS=86400

# Model & Pricing Configuration (USD per 1M tokens)
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_INPUT_COST_PER_1M=3.00
CLAUDE_OUTPUT_COST_PER_1M=15.00

# Hard Execution Budgets
MAX_SUB_QUESTIONS=5
MAX_SEARCHES_PER_SUB_QUESTION=3
MAX_TOTAL_SEARCHES=15
MAX_TOTAL_TOKENS=100000
MAX_COST_USD=1.00
MAX_DURATION_SECONDS=240
MAX_REVISION_ATTEMPTS=1

# Source Quality Constraints
MAX_RESULTS_PER_DOMAIN=2
EXTRACTION_TIMEOUT_SECONDS=10.0
MAX_EXTRACTED_CHARS=6000
